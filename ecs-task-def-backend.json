{
  "family": "snapshot-backend-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::932705495982:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "snapshot-backend",
      "portMappings": [
        { "containerPort": 8000, "protocol": "tcp" }
      ],
      "essential": true,
      "environment": [
        { "name": "DJANGO_SETTINGS_MODULE", "value": "Starter.settings" }
      ]
    }
  ]
}
